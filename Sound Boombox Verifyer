-- Auto-Equip System Logic
local function autoEquipItem()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    if not humanoid or not backpack then return end

    -- Check if tool is already in Backpack or Character
    local foundTool = nil
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            foundTool = item
            break
        end
    end

    if not foundTool then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
                foundTool = item
                break
            end
        end
    end

    -- Equip tool if found in player inventory
    if foundTool then
        humanoid:EquipTool(foundTool)
        statusLabel.Text = "Equipped: " .. foundTool.Name
        statusLabel.TextColor3 = Color3.fromRGB(16, 185, 129)
    else
        -- Fallback: Attach sound directly to player root part
        attachSound()
    end
end

-- Server Replication Broadcast System
local function broadcastToServer(assetId)
    local character = LocalPlayer.Character
    if not character then return end

    -- Search for server Boombox Remote Events in Character or ReplicatedStorage
    local remotes = {}
    
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("RemoteEvent") and (obj.Name:lower():find("boombox") or obj.Name:lower():find("sound") or obj.Name:lower():find("play")) then
            table.insert(remotes, obj)
        end
    end
    
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and (obj.Name:lower():find("boombox") or obj.Name:lower():find("sound") or obj.Name:lower():find("play")) then
            table.insert(remotes, obj)
        end
    end

    -- Fire remotes to ensure replication across the server
    for _, remote in ipairs(remotes) do
        pcall(function()
            remote:FireServer(tostring(assetId))
            remote:FireServer(tonumber(assetId))
        end)
    end
end

-- Sound Processing Logic
local function processSoundId()
    local cleanId = textBox.Text:gsub("%D", "")
    local assetId = tonumber(cleanId)

    if not assetId or assetId <= 0 then
        statusLabel.Text = "Unverified: Invalid Audio ID"
        statusLabel.TextColor3 = Color3.fromRGB(239, 68, 68) -- Red
        sound:Stop()
        return
    end

    -- Force local playback
    sound.SoundId = "rbxassetid://" .. assetId
    sound:Play()

    -- Broadcast to server remotes for game-wide replication
    broadcastToServer(assetId)

    statusLabel.Text = "Playing audio... Verifying store..."
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)

    -- Check Roblox Store for Verification status
    task.spawn(function()
        local success, info = pcall(function()
            return MarketplaceService:GetProductInfo(assetId, Enum.InfoType.Asset)
        end)

        if success and info and info.AssetTypeId == 3 then
            local isPublic = info.IsPublicDomain or info.IsForSale or false
            if isPublic then
                statusLabel.Text = "Verified on Roblox Store | " .. info.Name
                statusLabel.TextColor3 = Color3.fromRGB(16, 185, 129) -- Green
            else
                statusLabel.Text = "Unverified / Private Asset (Playing) | " .. info.Name
                statusLabel.TextColor3 = Color3.fromRGB(239, 68, 68) -- Red
            end
        else
            statusLabel.Text = "Unverified Asset (Playing)"
            statusLabel.TextColor3 = Color3.fromRGB(239, 68, 68) -- Red
        end
    end)
end

